# Local Vite proxy forwards /api to the backend at 127.0.0.1:4000.
VITE_API_BASE_URL=/api
VITE_SUBSCRIPTIONS_ENABLED=false
VITE_DEMO_DATA_ENABLED=false

# Backend only. Keep these out of client-side VITE_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FRONTEND_ORIGIN=http://127.0.0.1:5173
BACKEND_ORIGIN=http://127.0.0.1:4000
PORT=4000
# Optional: local image folder; defaults to backend/storage/images (10 GB cap).
# FASHIONHUB_STORAGE_DIR=C:/FashionHub-images
